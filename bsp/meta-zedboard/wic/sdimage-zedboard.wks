# ZedBoard SD card image.
#
# partition 1 (FAT32, active): the Zynq BootROM only mounts FAT32 and looks
# for BOOT.BIN in the root of the first partition. U-Boot SPL (boot.bin),
# u-boot.img, zImage, zynq-zed.dtb, boot.scr and the bitstream live here too.
# partition 2 (ext4): openEuler rootfs.
part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 1024 --size 64 --mkfs-extraopts="-F 32"
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label root --align 1024