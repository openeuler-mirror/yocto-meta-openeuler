#!/bin/sh
# Mirror the 8 slide switches (gpio-keys BTN_0..BTN_7) onto ld0..ld7
LEDS=/sys/class/leds
set_led() { echo "$2" > $LEDS/ld$1/brightness; }

sync_all() {
    for i in 0 1 2 3 4 5 6 7; do
        v=$(awk -v n="sw$i" 'index($0,"|" n " "){ if (match($0,/in  (hi|lo)/,m)) print ((m[1]=="hi")?1:0) }' /sys/kernel/debug/gpio 2>/dev/null)
        [ -n "$v" ] && set_led "$i" "$v"
    done
}

sync_all

exec 3</dev/input/event0
while :; do
    set -- $(dd bs=16 count=1 <&3 2>/dev/null | od -An -tu4)
    [ $# -ge 4 ] || break
    t=$(( $3 & 0xffff ))
    c=$(( $3 >> 16 ))
    v=$4
    if [ "$t" -eq 1 ] && [ "$c" -ge 256 ] && [ "$c" -le 263 ]; then
        i=$((c - 256))
        [ "$v" -ne 0 ] && v=1
        echo "$v" > $LEDS/ld$i/brightness
    fi
done