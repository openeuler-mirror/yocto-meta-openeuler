/dts-v1/;

/ {
    #address-cells = <0x2>;
    #size-cells = <0x2>;
    model = "Hisilicon Hi1712 ASIC";
    compatible = "hisilicon, hi1712_asic";
    interrupt-parent = <&gic>;

    aliases {
        serial0 = &uart2;
    };

    chosen {
        bootargs = "console=ttyS0,115200n8N earlycon=uart8250,mmio32,0x18330000 initrd=${initrd_load_addr},0x3600000 rdinit=/sbin/init rw ekbox=0x20000$0x84be0000 kbox_mem=0x2e0000@0x84900000 swift_irqsoff_enable swxn=1 ramdisk_size=51200";
    };

    memory@80000000 {
        device_type = "memory";
        reg = <0x0 0x80000000 0x1 0x00000000>;
    };

    reserved-memory {
                #address-cells = <0x2>;
                #size-cells = <0x2>;
                ranges;

                mcs@90000000 {
                        reg = <0x0 0x90000000 0x0 0x5000000>;
                        compatible = "mcs_mem";
                        no-map;
                };

        pfp@95000000 {
                        reg = <0x0 0x95000000 0x0 0x30000 0x0 0x0 0x0 0x30000>;
                        compatible = "pfp_mem";
                        no-map;
                };

        mcs_image@93000000 {
                        compatible = "mcs_image";
            domain=<0x93000000 0x100000>;
                };

        mcs_openamp@0x90000000 {
                        compatible = "mcs_openamp";
            domain=<0x90000000 0x30000 0x10 0x4000>; /* shmem_addr shmem_size vring_size vdev_status_size */
                };

        sac_mem@8dc00000 {
            reg = <0x0 0x8dc00000 0x0 0x02400000>;
            compatible = "sac_mem";
            no-map;
        };
        };

    mcs_linx170@0x188A0000 {
        compatible = "hisilicon, mcs_linx170";
        reg = <0x0 0x188A0000 0x0 0x10000>;
        interrupts = <0x0 189 0x4>;
    };

    psci {
        compatible = "arm,psci-0.2";
        method = "smc";
    };

    cpus {
        #address-cells = <0x1>;
        #size-cells = <0x0>;

        CPU0: cpu@0 {
                device_type = "cpu";
                compatible = "arm,armv8";
                reg = <0x000>;
                enable-method = "psci";
                cpu-release-addr = <0x0 0x9807fff8>;
        };

        CPU1: cpu@1 {
                device_type = "cpu";
                compatible = "arm,armv8";
                reg = <0x100>;
                enable-method = "psci";
                cpu-release-addr = <0x0 0x9807fff8>;
        };
        CPU2: cpu@2 {
                device_type = "cpu";
                compatible = "arm,armv8";
                reg = <0x200>;
                enable-method = "psci";
                cpu-release-addr = <0x0 0x9807fff8>;
        };
        CPU3: cpu@3 {
                device_type = "cpu";
                compatible = "arm,armv8";
                reg = <0x300>;
                enable-method = "psci";
                cpu-release-addr = <0x0 0x9807fff8>;
        };
    };

    cpu_extra_info {
        compatible = "cpu_info,extra_info";
        cpu_desc = "1711";
    };

    gic: interrupt-controller@1a000000 {
        compatible = "arm,gic-v3";
        #interrupt-cells = <3>;
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;
        interrupt-controller;
        #redistributor-regions = <1>;
        redistributor-stride = <0x0 0x20000>;
        reg = <0x0 0x1a000000 0x0 0x10000>,     /*GICD*/
              <0x0 0x1a040000 0x0 0x80000>;     /*GICR (cpu0-cpu3)*/
        interrupts = <0x1 0x9 0xff04>;
    };

    rtos_softdog {
        compatible = "rtos-wtd-config";
        softdog-enable = <1>;
    };

    fiq_glue@0x2000B000 {
        compatible = "arm,hisi_fiq";
        fiq_source = "GIC";
        fiq_type = "1-N";
        dead_loop = <1>;
        need_invalid_cache = <1>;
        fiq_nums = <1>;
        interrupts = <0 51 3>;
        #address-cells = <1>;
        #size-cells = <1>;
        ranges = <0x0 0x0 0x0 0xc0000000>;
    };

    timer {
        compatible = "arm,armv8-timer";
        interrupts = <0x1 0xd 0xff08>,
                     <0x1 0xe 0xff08>,
                     <0x1 0xb 0xff08>,
                     <0x1 0xa 0xff08>;
    };

    pmu {
        compatible = "arm,armv8-pmuv3";
        interrupts = <0x1 0x7 0x4>;
    };

    bmcrtc: rtc@0 {
            compatible = "hisilicon,bmcrtc";
            reg = <0x0 0x18930000 0x0 0x1000>;
    };

    reboot_handler@0 {
        compatible = "hisilicon,hisi-reboot";
        reg = <0x0 0x08740000 0x0 0x1000>;
        reboot-offset = <0x148>;
        reboot-value = <0x8>;
    };

    soc {
        compatible = "simple-bus";
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;

        hi1711_refclk: refclk {
            compatible = "fixed-clock";
            #clock-cells = <0>;
            clock-frequency = <25000000>;
        };

        io_config:io_cfg@0x18960000 {
            compatible = "hisilicon, hisi_iocfg";
            reg = <0x0 0x18960000 0x0 0x1000>;
            io_cfg_val = <0x000b803f 0x18000000 0x0aa2aa00 0x00f1000f 0x2000012f 0x0>;
        };

        uart2: uart2@18330000 {
            compatible = "snps,dw-apb-uart";
            reg = <0x0 0x18330000 0x0 0x800>;
            reg-io-width = <4>;
            reg-shift = <2>;
            clock-frequency = <100000000>;
            clock-names = "apb_pclk";
            interrupts = <0 78 4>;
            current-speed = <0x1c200>;
        };

        uart_core: uart_core {
            compatible = "hisilicon,hisi-uart-core";
            clock-frequency = <100000000>;
        };

        uart3: uart3@18340000 {
            compatible = "hisilicon,hisi-uart";
            reg = <0x0 0x18340000 0x0 0x800>;/* UART3 */
            interrupts = <0 79 4>;
            port-no = <3>;
        };

        uart4: uart4@18350000 {
            compatible = "hisilicon,hisi-uart";
            reg = <0x0 0x18350000 0x0 0x800>;/* UART4 */
            interrupts = <0 80 4>;
            port-no = <4>;
        };

        uart5: uart5@18360000 {
            compatible = "hisilicon,hisi-uart";
            reg = <0x0 0x18360000 0x0 0x800>;/* UART5 */
            interrupts = <0 81 4>;
            port-no = <5>;
        };

        uart6: uart6@18370000 {
            compatible = "hisilicon,hisi-uart";
            reg = <0x0 0x18370000 0x0 0x700>;/* UART6 */
            interrupts = <0 82 4>;
            port-no = <6>;
        };

        uart7: uart7@18380000 {
            compatible = "hisilicon,hisi-uart";
            reg = <0x0 0x18380000 0x0 0x800>;/* UART7 */
            interrupts = <0 83 4>;
            port-no = <7>;
        };

        uart8: uart8@18760000 {
            compatible = "hisilicon,hisi-uart";
            reg = <0x0 0x18760000 0x0 0x1000>;/* UART8 */
            interrupts = <0 84 4>;
            port-no = <8>;
        };

        uart9: uart9@18770000 {
            compatible = "hisilicon,hisi-uart";
            reg = <0x0 0x18770000 0x0 0x1000>;/* UART9 */
            interrupts = <0 85 4>;
            port-no = <9>;
        };

        uart10: uart10@18780000 {
            compatible = "hisilicon,hisi-uart";
            reg = <0x0 0x18780000 0x0 0x1000>;/* UART10 */
            interrupts = <0 86 4>;
            port-no = <10>;
        };
        uart11: uart11@18790000 {
            compatible = "hisilicon,hisi-uart";
            reg = <0x0 0x18790000 0x0 0x1000>;/* UART11 */
            interrupts = <0 87 4>;
            port-no = <11>;
        };

        uart12: uart12@187a0000 {
            compatible = "hisilicon,hisi-uart";
            reg = <0x0 0x187a0000 0x0 0x1000>;/* UART12 */
            interrupts = <0 88 4>;
            port-no = <12>;
        };

        uart0: uart0@18993000 {
            compatible = "hisilicon,hisi-uart";
            reg = <0x0 0x18993000 0x0 0x100>;/* HISPort Uart */
            interrupts = <0 181 4>;
            port-no = <0>;/* HISPort0 Uart mux with espi0/lpc uart0 */
        };

        uart1: uart1@189c3000 {
            compatible = "hisilicon,hisi-uart";
            reg = <0x0 0x189c3000 0x0 0x100>;/* HISPort Uart */
            interrupts = <0 175 4>;
            port-no = <1>;/* HISPort1 Uart mux with espi0/lpc uart1 */
        };

        timer0@18300000 {
            compatible = "hisilicon,hisi-timer";
            ids = /bits/ 32 <0x0>;
            reg = <0x0 0x18300000 0x0 0x40>;
            clock-sel = /bits/ 32 <2>; /* use bus clock(apb 100mhz)*/
            interrupts = <0 52 4>;
        };

        timer1@18300040 {
            compatible = "hisilicon,hisi-timer";
            ids = /bits/ 32 <0x1>;
            reg = <0x0 0x18300040 0x0 0x40>;
            clock-sel = /bits/ 32 <2>;
            interrupts = <0 53 4>;
        };

        timer2@18310000 {
            compatible = "hisilicon,hisi-timer";
            ids = /bits/ 32 <0x2>;
            reg = <0x0 0x18310000 0x0 0x40>;
            clock-sel = /bits/ 32 <2>;
            interrupts = <0 54 4>;
        };

        timer3@18310040 {
            compatible = "hisilicon,hisi-timer";
            ids = /bits/ 32 <0x3>;
            reg = <0x0 0x18310040 0x0 0x40>;
            clock-sel = /bits/ 32  <2>;
            interrupts = <0 55 4>;
        };

        timer4@18320000 {
            compatible = "hisilicon,hisi-timer";
            ids = /bits/ 32 <0x4>;
            reg = <0x0 0x18320000 0x0 0x40>;
            clock-sel = /bits/ 32 <2>;
            interrupts = <0 56 4>;
        };

        timer5@18320040 {
            compatible = "hisilicon,hisi-timer";
            ids = /bits/ 32 <0x5>;
            reg = <0x0 0x18320040 0x0 0x40>;
            clock-sel = /bits/ 32  <2>;
            interrupts = <0 57 4>;
        };

        comm@18950000 {
            compatible = "hisilicon, hisi-comm";
            interrupts = <0 128 4>,   /* fnpll_dlock_int */
                         <0 176 4>,   /* host0_rst_pos_int */
                         <0 191 4>,   /* host0_rst_int */
                         <0 182 4>,   /* pcie0_rst_pos_int */
                         <0 207 4>,   /* pcie0_rst_int */
                         <0 177 4>,   /* pcie1_rst_pos_int */
                         <0 206 4>,   /* pcie1_rst_int */
                         <0 129 4>,   /* host1_rst_pos_int */
                         <0 183 4>,   /* host1_rst_int */
                         <0 115 4>,   /* a55_lock_int_ff */
                         <0 41  4>,   /* hp_ecc_err_int */
                         <0 157 4>;   /* lp_ecc_err_int */
        };

        gpio0: gpio0@0x18390000 {
            compatible = "hisilicon, hisi-gpio";
            reg = <0x0 0x18390000 0x0 0x10000>;
            interrupts = <0x0 60 0x4>;
            ngpios = <32>;
            host_id = <0x00>;
            domain = <0x1>;
            gpio-controller;
            #gpio-cells = <2>;
        };

        gpio1: gpio1@0x183a0000 {
            compatible = "hisilicon, hisi-gpio";
            reg = <0x0 0x183a0000 0x0 0x10000>;
            interrupts = <0x0 61 0x4>;
            ngpios = <32>;
            host_id = <0x01>;
            domain = <0x1>;
            gpio-controller;
            #gpio-cells = <2>;
        };

        gpio2: gpio2@0x183b0000 {
            compatible = "hisilicon, hisi-gpio";
            reg = <0x0 0x183b0000 0x0 0x10000>;
            interrupts = <0x0 62 0x4>;
            ngpios = <32>;
            host_id = <0x02>;
            domain = <0x1>;
            gpio-controller;
            #gpio-cells = <2>;
        };

        gpio3: gpio3@0x183c0000 {
            compatible = "hisilicon, hisi-gpio";
            reg = <0x0 0x183c0000 0x0 0x10000>;
            interrupts = <0x0 63 0x4>;
            ngpios = <32>;
            host_id = <0x03>;
            domain = <0x1>;
            gpio-controller;
            #gpio-cells = <2>;
        };

        gpio4: gpio4@0x183d0000 {
            compatible = "hisilicon, hisi-gpio";
            reg = <0x0 0x183d0000 0x0 0x10000>;
            interrupts = <0x0 64 0x4>;
            ngpios = <32>;
            host_id = <0x04>;
            domain = <0x1>;
            gpio-controller;
            #gpio-cells = <2>;
        };

        i2c_bus0: i2c@18400000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c0";
            reg = <0x0 0x18400000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 141 0x4>;
        };

        i2c_bus1: i2c@18410000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c1";
            reg = <0x0 0x18410000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 142 0x4>;
        };

        i2c_bus2: i2c@18420000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c2";
            reg = <0x0 0x18420000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 143 0x4>;
        };

        i2c_bus3: i2c@18430000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c3";
            reg = <0x0 0x18430000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 144 0x4>;
        };

        i2c_bus4: i2c@18440000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c4";
            reg = <0x0 0x18440000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 145 0x4>;
        };

        i2c_bus5: i2c@18450000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c5";
            reg = <0x0 0x18450000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 146 0x4>;
        };

        i2c_bus6: i2c@18460000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c6";
            reg = <0x0 0x18460000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 147 0x4>;
        };

        i2c_bus7: i2c@18470000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c7";
            reg = <0x0 0x18470000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 148 0x4>;
        };

        i2c_bus8: i2c@18480000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c8";
            reg = <0x0 0x18480000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 149 0x4>;
        };

        i2c_bus9: i2c@18490000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c9";
            reg = <0x0 0x18490000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 150 0x4>;
        };

        i2c_bus10: i2c@184A0000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c10";
            reg = <0x0 0x184A0000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 151 0x4>;
        };

        i2c_bus11: i2c@184B0000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c11";
            reg = <0x0 0x184B0000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 152 0x4>;
        };

        i2c_bus12: i2c@184C0000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c12";
            reg = <0x0 0x184C0000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 153 0x4>;
        };

        i2c_bus13: i2c@184D0000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c13";
            reg = <0x0 0x184D0000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 154 0x4>;
        };

        i2c_bus14: i2c@184E0000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c14";
            reg = <0x0 0x184E0000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 155 0x4>;
        };

        i2c_bus15: i2c@184F0000 {
            compatible = "hisilicon,hi309x-i2c";
            label = "hi309x_i2c15";
            reg = <0x0 0x184F0000 0x0 0x1000>;
            clock-frequency = <100000>;
            interrupts = <0x0 156 0x4>;
        };

        /*
         * The i2c@18400000 node is used to implement the method in the src/non_real_time/drivers/i2c directory.
         * This method does not use the Linux kernel framework.
         * If you need to use this driver, delete i2c_bus0 to i2c_bus15 and use the i2c@2000d000 node.
         */
        /*
         * i2c@18400000 {
         *     compatible = "hisilicon, hisi-i2c";
         *     reg = <0x0 0x18400000 0x0 0x1000>,
         *           <0x0 0x18410000 0x0 0x1000>,
         *           <0x0 0x18420000 0x0 0x1000>,
         *           <0x0 0x18430000 0x0 0x1000>,
         *           <0x0 0x18440000 0x0 0x1000>,
         *           <0x0 0x18450000 0x0 0x1000>,
         *           <0x0 0x18460000 0x0 0x1000>,
         *           <0x0 0x18470000 0x0 0x1000>,
         *           <0x0 0x18480000 0x0 0x1000>,
         *           <0x0 0x18490000 0x0 0x1000>,
         *           <0x0 0x184A0000 0x0 0x1000>,
         *           <0x0 0x184B0000 0x0 0x1000>,
         *           <0x0 0x184C0000 0x0 0x1000>,
         *           <0x0 0x184D0000 0x0 0x1000>,
         *           <0x0 0x184E0000 0x0 0x1000>,
         *           <0x0 0x184F0000 0x0 0x1000>; // 0-15 i2c_reg
         *     interrupts = <0x0 141 0x4>,
         *                  <0x0 142 0x4>,
         *                  <0x0 143 0x4>,
         *                  <0x0 144 0x4>,
         *                  <0x0 145 0x4>,
         *                  <0x0 146 0x4>,
         *                  <0x0 147 0x4>,
         *                  <0x0 148 0x4>,
         *                  <0x0 149 0x4>,
         *                  <0x0 150 0x4>,
         *                  <0x0 151 0x4>,
         *                  <0x0 152 0x4>,
         *                  <0x0 153 0x4>,
         *                  <0x0 154 0x4>,
         *                  <0x0 155 0x4>,
         *                  <0x0 156 0x4>; // 0-15
         * };
         */

        i3c@0x18600000 {
            compatible = "hisilicon, hisi-i3c";
            reg = <0x0 0x18600000 0x0 0x1000>,
                  <0x0 0x18610000 0x0 0x1000>,
                  <0x0 0x18620000 0x0 0x1000>,
                  <0x0 0x18630000 0x0 0x1000>,
                  <0x0 0x18640000 0x0 0x1000>,
                  <0x0 0x18650000 0x0 0x1000>,
                  <0x0 0x18660000 0x0 0x1000>,
                  <0x0 0x18670000 0x0 0x1000>,
                  <0x0 0x18690000 0x0 0x1000>,
                  <0x0 0x186a0000 0x0 0x1000>,
                  <0x0 0x186b0000 0x0 0x1000>,
                  <0x0 0x186c0000 0x0 0x1000>;

            interrupts = <0x0 160 0x4>,
                         <0x0 161 0x4>,
                         <0x0 162 0x4>,
                         <0x0 163 0x4>,
                         <0x0 164 0x4>,
                         <0x0 165 0x4>,
                         <0x0 166 0x4>,
                         <0x0 167 0x4>,
                         <0x0 168 0x4>,
                         <0x0 169 0x4>,
                         <0x0 170 0x4>,
                         <0x0 171 0x4>;
        };

        i2s@0x18850000 {
            compatible = "hisilicon, hisi-i2s";
            reg = <0x0 0x18850000 0x0 0x3000>;
            interrupts = <0x0 173 0x4>;
        };

        sfc0@18220000 {
            compatible = "hisilicon, hisi-sfc0";
            reg = <0x0 0x18220000 0x0 0x8000>,
                  <0x0 0x60000000 0x0 0x10000000>;/*0 sfc0 reg,1 sfc0 cs0 cs1 buf 256MB*/
            sfccsid = <3>;/*cs0 used bit0, cs1 bit1*/
            busid = <0>;
            use_hw_lock = <1>;/*0-not use, 1-use*/
            hw_lock_id = <4>;
            interrupts = <0x0 138 0x4>;
        };

        sfc1@18230000 {
            compatible = "hisilicon, hisi-sfc1";
            reg = <0x0 0x18230000 0x0 0x8000>,
                  <0x0 0x70000000 0x0 0x10000000>;/*0 sfc1 reg,1 sfc1 cs0 cs1 buf 256MB*/
            sfccsid = <3>;/*cs0 used bit0, cs1 bit1*/
            busid = <1>;
            use_hw_lock = <0>;/*0-not use, 1-use*/
            hw_lock_id = <5>;
            interrupts = <0x0 139 0x4>;
        };

        spi0@187B0000 {
            compatible = "hisilicon,hisi-spi";
            ctlid = /bits/ 32 <0x0>;
            reg = <0x0 0x187B0000 0x0 0x1000>;
            clock-sel = /bits/ 32 <2>; // 0: FPGA freq, 2(or any other value): use bus clock(apb 100mhz)
            interrupts = <0 158 4>;
            num-cs = <2>;

            // 如需使用GPIO cs功能，在spi0节点中添加下面注释内容，两个GPIO引脚按顺序代表片选0，1
            /* cs-gpios = <&gpio1 11 0>, <&gpio1 7 0>; */

            spidev0_0: spidev0_0 {
                compatible = "rohm,dh2228fv";
                reg = <0x0>;
                spi-max-frequency = <20000000>;
                spi-cpol;
                spi-cpha;
            };

            spidev0_1: spidev0_1 {
                compatible = "rohm,dh2228fv";
                reg = <0x1>;
                spi-max-frequency = <20000000>;
                spi-cpol;
                spi-cpha;
            };
        };

        spi1@187C0000 {
            compatible = "hisilicon,hisi-spi";
            ctlid = /bits/ 32 <0x1>;
            reg = <0x0 0x187C0000 0x0 0x1000>;
            clock-sel = /bits/ 32 <2>; // 0: FPGA freq, 2(or any other value): use bus clock(apb 100mhz)
            interrupts = <0 159 4>;
            num-cs = <2>;

            // 如需使用GPIO cs功能，在spi0节点中添加下面注释内容，两个GPIO引脚按顺序代表片选0，1
            /* cs-gpios = <&gpio2 31 0>, <&gpio3 0 0>; */

            spidev1_0: spidev1_0 {
                compatible = "rohm,dh2228fv";
                reg = <0x0>;
                spi-max-frequency = <20000000>;
                spi-cpol;
                spi-cpha;
            };

            spidev1_1: spidev1_1 {
                compatible = "rohm,dh2228fv";
                reg = <0x1>;
                spi-max-frequency = <20000000>;
                spi-cpol;
                spi-cpha;
            };
        };

        pwm@18920000{
            compatible = "hisilicon, hi309x-pwm";
            reg = <0x0 0x18920000 0x0 0x1000>,
                  <0x0 0x08745000 0x0 0x1000>;/*TODO:reg0,reg1,io config*/
            interrupts = <0 132 4>,
                         <0 133 4>;  /*164-32,165-32*/
