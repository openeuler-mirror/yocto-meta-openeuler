            interrupts = <0x0 196 0x4>;
            controller_id = <4>;
            controller_subsys = "hp";
            #address-cells = <2>;
            #size-cells = <2>;
            ranges;
            status = "okay";

            hiusbc@1d000000 {
                compatible = "hisilicon,hiusbc";
                reg = <0x0 0x1d000000 0x0 0x100000>;
                interrupts = <0x0 202 0x4>;
                dr_mode = "host";
