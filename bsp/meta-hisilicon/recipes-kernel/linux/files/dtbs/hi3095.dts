            interrupts = <0x0 222 0x4>, /* host gmac ecc  */
                         <0x0 223 0x4>, /* host mdio0     */
                         <0x0 224 0x4>, /* host mdio1     */
                         <0x0 216 0x4>, /* host gmac2 tx  */
                         <0x0 217 0x4>, /* host gmac2 rx  */
                         <0x0 218 0x4>, /* host gmac2 err */
                         <0x0 219 0x4>, /* host gmac3 tx  */
                         <0x0 220 0x4>, /* host gmac3 rx  */
                         <0x0 221 0x4>, /* host gmac3 err */
