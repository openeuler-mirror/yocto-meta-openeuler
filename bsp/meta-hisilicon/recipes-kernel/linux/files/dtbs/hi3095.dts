        host_sata@1f200000 {
            compatible = "hisilicon", "generic-ahci";
            reg = <0x0 0x1f200000 0x0 0x1000>;
            interrupts = <0x0 227 0x4>;
            #address-cells = <1>;
            #size-cells = <0>;

            sata0: sata-port@0 {
                reg = <0>;
                phys = <&sata_phy 0>;
                status = "okay";
            };

            sata1: sata-port@1 {
                reg = <1>;
                phys = <&sata_phy 1>;
                status = "okay";
            };
        };

        sata_phy: phy@1f200000 {
            compatible = "hisilicon, hisi-sata-phy";
            reg = <0x0 0x1f200000 0x0 0x1000>;
            #phy-cells = <1>;

            sata_phy0: sata-phy@0 {
                reg = <0>;
                #phy-cells = <0>;
            };

            sata_phy1: sata-phy@1 {
                reg = <1>;
                #phy-cells = <0>;
            };
        };

