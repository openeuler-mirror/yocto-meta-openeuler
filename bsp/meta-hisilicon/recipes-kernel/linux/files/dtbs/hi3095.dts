        pcie0_ep@0x1e100000 {
            compatible = "hisilicon, hisi_pcie";
            reg = <0x0 0x1e100000 0x0 0x100000>;
            interrupts = <0x0 182 0x4>, /* pcie0 rst pos irq */
                         <0x0 241 0x4>, /* pcie0 ap sys local int0 irq */
                         <0x0 242 0x4>; /* pcie0 ap sys local int1 irq */
            core-id = <0>;
        };

        pcie1_ep@0x1e200000 {
            compatible = "hisilicon, hisi_pcie";
            reg = <0x0 0x1e200000 0x0 0x100000>;
            interrupts = <0x0 177 0x4>, /* pcie1 rst pos irq */
                         <0x0 247 0x4>, /* pcie1 ap sys local int0 irq */
                         <0x0 248 0x4>; /* pcie1 ap sys local int1 irq */
            core-id = <1>;
        };

        pcie_test {
            compatible = "hisilicon, pcie-test";
            interrupts = <0x0 182 0x4>, /* rst pos irq */
                         <0x0 207 0x4>, /* rst irq */
                         <0x0 228 0x4>, /* ap sys inta irq */
                         <0x0 229 0x4>, /* ap sys intb irq */
                         <0x0 230 0x4>, /* ap sys intc irq */
                         <0x0 231 0x4>, /* ap sys intd irq */
                         <0x0 239 0x4>, /* ap sys err_eri irq */
                         <0x0 240 0x4>, /* ap sys err_fhi irq */
                         <0x0 241 0x4>, /* ap sys local int0 irq */
                         <0x0 242 0x4>, /* ap sys local int1 irq */
                         <0x0 177 0x4>, /* rst pos irq */
                         <0x0 206 0x4>, /* rst irq */
                         <0x0 232 0x4>, /* ap sys inta irq */
                         <0x0 233 0x4>, /* ap sys intb irq */
                         <0x0 237 0x4>, /* ap sys intc irq */
                         <0x0 238 0x4>, /* ap sys intd irq */
                         <0x0 245 0x4>, /* ap sys err_eri irq */
                         <0x0 246 0x4>, /* ap sys err_fhi irq */
                         <0x0 247 0x4>, /* ap sys local int0 irq */
                         <0x0 248 0x4>; /* ap sys local int1 irq */
        };

        pcie2_rc@1e100000 {
            compatible = "hisilicon,pcie2-rc";
            reg = <0 0x30000000 0 0x10000000>,  /* ecam */
                  <0 0x1e100000 0 0x100000>;    /* reg */
            reg-names = "config";
            interrupts = <0x0 241 0x4>; /* PCIE0 msi(intb) irq */
            bus-range = <0x0 0xff>;
            #address-cells = <3>;
            #size-cells = <2>;
            device_type = "pci";
            ranges = <0x02000000 0x0 0x28000000 0x0 0x28000000 0x0 0x8000000>,
                     <0x03000000 0x2 0x80000000 0x2 0x80000000 0x0 0x60000000>;
            num-lanes = <2>;
            core-id = <0>;
            port-id = <0>;
            status = "ok";
        };

        pcie2_rc@1e200000 {
            compatible = "hisilicon,pcie2-rc";
            reg = <0 0x40000000 0 0x10000000>,  /* ecam */
                  <0 0x1e200000 0 0x100000>;    /* reg */
            reg-names = "config";
            interrupts = <0x0 247 0x4>; /* PCIE1 msi(intb) irq */
            bus-range = <0x0 0xff>;
            #address-cells = <3>;
            #size-cells = <2>;
            device_type = "pci";
            ranges = <0x02000000 0x0 0x50000000 0x0 0x50000000 0x0 0x10000000>,
                     <0x03000000 0x3 0x00000000 0x3 0x00000000 0x1 0x00000000>;
            num-lanes = <1>;
            core-id = <1>;
            port-id = <0>;
            status = "ok";
        };

        bmc_driver@CD10000 {
            compatible = "hisilicon,hi1711-bmc_driver";
            reg = <0x0 0xCD10000 0x0 0x1000>,/*HI1711_PCI1_DM_BASE*/
                  <0x0 0xCD0E000 0x0 0x1000>;
            interrupts = <0x0 218 0x4>;/*pcie1 edma irq*/
        };

        bmc_vnet_driver@CD10000 {
            compatible = "hisilicon,hi1711-bmc_vnet_driver";
            reg = <0x0 0xCD10000 0x0 0x1000>,/*HI1711_PCI1_DM_BASE*/
                  <0x0 0xCD0E000 0x0 0x1000>;
            interrupts = <0x0 131 0x4>;/*h2b_edma_int*/
        };

        mctp@1C00A000{
            compatible = "hisilicon,hi1711-mctp_driver";
            reg = <0x0 0xcd05000 0x0 0x100>;
            interrupts = <0x0 117 0x4>;/*mctp irq*/
        };

        vce@08b0c000{
            compatible = "hisilicon,hi1711-vce_driver";
            reg = <0x0 0x08b0c000 0x0 0x4000>;
            interrupts = <0x0 113 0x4>;/*vce irq*/
        };

        hwlock@08740000 {
            compatible = "hisilicon,hi1711-hwlock";
            interrupts = <0x0 38 0x4>;
        };

        msg_sc_comm@08740000 {
            compatible = "hisilicon, hisi-msg_sc_comm";
        };

        msg_mailbox@08740000 {
            compatible = "hisilicon, hisi-msg_mailbox";
            reg = <0x0 0x18A00000 0x0 0x10000>;
            interrupts = <0x0 76 0x4>;
        };

        msg_coprocessor@08740000 {
            compatible = "hisilicon, hisi-msg_coprocessor";
            reg = <0x0 0x188A0000 0x0 0x10000>;
            interrupts = <0x0 189 0x4>;
        };

        serdes@1E000000 {
            compatible = "hisilicon, hisi-serdes";
            reg = <0x0 0x1E080000 0x0 0x10000>, /* Hilink10_0 */
                  <0x0 0x1E090000 0x0 0x10000>, /* Hilink10_1 */
                  <0x0 0x1E0A0000 0x0 0x10000>, /* Hilink10_2 */
                  <0x0 0x1C000000 0x0 0x10000>, /* Hilink10_3 */
                  <0x0 0x1C040000 0x0 0x10000>, /* Hilink10_4 */
                  <0x0 0x1C050000 0x0 0x10000>, /* Hilink10_5 */
                  <0x0 0x1E000000 0x0 0x80000>; /* Hilink25 */
        };

        hisport0@18990000 {
            compatible = "hisilicon, hisport";
            hisport_id = <0>;
            reg = <0x0 0x18990000 0x0 0x2000>;
            interrupts = <0x0 185 0x4>,
                         <0x0 184 0x4>;
        };

        hisport1@189c0000 {
            compatible = "hisilicon, hisport";
            hisport_id = <1>;
            reg = <0x0 0x189c0000 0x0 0x2000>;
            interrupts = <0x0 179 0x4>,
                         <0x0 178 0x4>;
        };

        mctp0@1E10A000 {
            compatible = "hisilicon, hi1712-mctp_driver";
            mctp_id = <0>;
            reg = <0x0 0x1E10A000 0x0 0x2000>;
            interrupts = <0x0 243 0x4>,
                         <0x0 244 0x4>;
        };

        mctp1@1E20A000 {
            compatible = "hisilicon, hi1712-mctp_driver";
            mctp_id = <1>;
            reg = <0x0 0x1E20A000 0x0 0x2000>;
            interrupts = <0x0 249 0x4>,
                         <0x0 250 0x4>;
        };

        gpu@240000000 {
            compatible = "hisilicon, hisi-gpu";
            reg = <0x0 0x24000000 0x0 0x200000>,
                  <0x0 0x80000000 0x0 0x2000000>;
            interrupts = <0x0 235 0x4>,
                         <0x0 251 0x4>;
        };

        panel_lvds: panel-lvds {
            compatible = "panel-lvds";
            lable = "LVDS";
            width-mm = <191>;
            height-mm = <115>;
            data-mapping = "jeida-18";
            status = "okay";

            panel-timing {
                clock-frequency = <45000000>;
                hactive = <1280>;
                vactive = <720>;
                hback-porch = <40>;
                hfront-porch = <112>;
                vback-porch = <39>;
                vfront-porch = <21>;
                hsync-len = <10>;
                vsync-len = <20>;
                hsync-active = <0>;
                vsync-active = <1>;
                de-active = <1>;
                pixelclk-active = <0>;
            };
        };

        ucmi0@26800000 {
            compatible = "hisilicon, ucmi";
            ucmi_id = <0>;
            reg = <0x0 0x181f0000 0x0 0x1000>;
            interrupts = <0x0 108 0x4>;
        };

        ucmi1@27000000 {
            compatible = "hisilicon, ucmi";
            ucmi_id = <1>;
            reg = <0x0 0x181f1000 0x0 0x1000>;
            interrupts = <0x0 121 0x4>;
        };

        bt{
            compatible = "simple-bus";
            #address-cells = <2>;
            #size-cells = <2>;
            ranges;
            bt-ucmi0{
                compatible = "hisilicon,ucmi,bt";
                group = <0>;
                bt_type = <2>;
                reg = <0x0 0x181E0000 0x0 0x1000>,
                      <0x0 0x181E1000 0x0 0x1000>,
                      <0x0 0x181E2000 0x0 0x1000>,
                      <0x0 0x181E3000 0x0 0x1000>,
                      <0x0 0x181E4000 0x0 0x1000>,
                      <0x0 0x181E5000 0x0 0x1000>,
                      <0x0 0x181E6000 0x0 0x1000>,
                      <0x0 0x181E7000 0x0 0x1000>,
                      <0x0 0x181E8000 0x0 0x1000>,
                      <0x0 0x181E9000 0x0 0x1000>,
                      <0x0 0x181EA000 0x0 0x1000>,
                      <0x0 0x181EB000 0x0 0x1000>,
                      <0x0 0x181EC000 0x0 0x1000>,
                      <0x0 0x181ED000 0x0 0x1000>,
                      <0x0 0x181EE000 0x0 0x1000>,
                      <0x0 0x181EF000 0x0 0x1000>;
                interrupts = <0x0 109 0x4>;
            };

            bt-ucmi1{
                compatible = "hisilicon,ucmi,bt";
                group = <1>;
                bt_type = <2>;
                reg = <0x0 0x181F2000 0x0 0x1000>,
                      <0x0 0x181F3000 0x0 0x1000>;
                interrupts = <0x0 122 0x4>;
            };

            bt-lpc{
                compatible = "hisilicon,lpc,bt";
                group = <0>;
                bt_type = <0>;
                reg = <0x0 0x18106000 0x0 0x1000>,
                      <0x0 0x18107000 0x0 0x1000>;
                interrupts = <0 108 4>,
                             <0 109 4>;
            };

            bt-espi0{
                compatible = "hisilicon,espi,bt";
                group = <0>;
                bt_type = <1>;
                reg = <0x0 0x18186000 0x0 0x1000>,
                      <0x0 0x18187000 0x0 0x1000>;
                interrupts = <0 108 4>,
                             <0 109 4>;
            };

            bt-espi1{
                compatible = "hisilicon,espi,bt";
                group = <1>;
                bt_type = <1>;
                reg = <0x0 0x181C6000 0x0 0x1000>,
                      <0x0 0x181C7000 0x0 0x1000>;
                interrupts = <0 121 4>,
                             <0 122 4>;
            };

            btc-pcie@0x84801000{
                compatible = "hisilicon,pcie,btc";
                group = <0>;
                bt_type = <3>;
                reg = <0x0 0x84801000 0x0 0x400>,
                      <0x0 0x84801400 0x0 0x400>;
            };
        };
    };
};
