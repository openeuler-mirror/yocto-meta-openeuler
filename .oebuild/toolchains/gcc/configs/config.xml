# =============================================================================
# cross-tools 全局版本与路径定义
# -----------------------------------------------------------------------------
# 用途：
#   - prepare.sh 据此从 .oebuild/manifest.yaml 拉取对应仓库到
#     ${LIB_PATH}/<NAME>/<NAME_DIR> 下（git clone + 解包 + 应用补丁）。
#   - update.sh 据此把每个 config_<arch> 里的 CT_*_CUSTOM_LOCATION 字段
#     统一替换成 ${LIB_PATH}/<NAME>/<NAME_DIR>。
#
# 修改某组件版本时，应同时检查：
#   1) 这里 <NAME>_DIR 的版本号；
#   2) .oebuild/manifest.yaml 中对应仓库的 version（commit）是否已切换到
#      目标版本对应的分支/标签；
#   3) configs/config_<arch> 中 CT_*_VERSION 与 CT_*_CUSTOM_LOCATION 的版本
#      是否需要同步（注：当版本号超出 crosstool-NG 当前已知 kconfig 列表
#      时，约定使用 VERY_NEW=y + VERSION="new"）。
# =============================================================================

# MANIFEST：相对脚本所在目录（gcc/，即 .oebuild/toolchains/gcc/）解析，
# prepare.sh 会用 realpath "${SRC_DIR}/${MANIFEST}" 转成绝对路径；因此该值
# 始终指向 .oebuild/manifest.yaml，不受调用方当前工作目录影响
MANIFEST=../../manifest.yaml

# COMPILER_INFO：仅作为日志/产物信息使用
COMPILER_INFO="gcc 12.3.0"

# 组件名 → 在 open_source/ 下的子目录名
KERNEL="kernel"
MUSLC="musl"
GCC="gcc"
BINUTILS="binutils"
MPFR="mpfr"
GMP="gmp"
MPC="libmpc"
ISL="isl"
GLIBC="glibc"
EXPAT="expat"
GETTEXT="gettext"
LIBICONV="libiconv"
NCURSES="ncurses"
ZLIB="zlib"
GDB="gdb"
ZSTD="zstd"

# 组件名 → 解包后的源码目录名（与上游版本号保持一致）
GCC_DIR="gcc-12.3.0"
BINUTILS_DIR="binutils-2.41"
MPFR_DIR="mpfr-4.2.1"
GMP_DIR="gmp-6.3.0"
MPC_DIR="mpc-1.3.1"
ISL_DIR="isl-0.24"
GLIBC_DIR="glibc-2.38"
MUSLC_DIR="musl-1.2.4"
EXPAT_DIR="expat-2.6.2"
GETTEXT_DIR="gettext-0.22"
LIBICONV_DIR="libiconv-1.16"
NCURSES_DIR="ncurses-6.4"
ZLIB_DIR="zlib-1.2.13"
GDB_DIR="gdb-14.1"
ZSTD_DIR="zstd-1.5.6"
