#
# config.xml — Clang+musl ARM32 编译链依赖配置
#
# 本文件被 prepare.sh 以 `source` 方式读取，定义编译链构建所需的：
#   - 32 位 GCC+musl 交叉编译链（二进制下载，来自 gitee releases）
#   - LLVM 源码仓（git clone）
#   - musl 源码仓（git fetch 指定 commit）
#
# 修改版本时需同步检查：
#   - GCC_MUSL_RELEASE_TAG 须与 gcc/release.yaml 中 tag_name 一致
#   - LLVM_BRANCH 须与 llvm-project 仓的实际分支名一致
#   - MUSL_COMMIT 须为 src-openeuler/musl 仓的有效 commit SHA
#

# --- 32位 GCC+musl 交叉编译链（二进制下载） ---
GCC_MUSL="openeuler_gcc_arm32le-musl"
GCC_MUSL_RELEASE_TAG="toolchains-v0.1.8"
GCC_MUSL_SPLIT_COUNT=3

# --- LLVM 源码 ---
LLVM="llvm-project"
LLVM_BRANCH="dev_19.1.7"
LLVM_REPO_URL="https://atomgit.com/openeuler/llvm-project"

# --- musl 源码 ---
MUSL="openeuler-musl"
MUSL_REPO_URL="https://atomgit.com/src-openeuler/musl.git"
MUSL_COMMIT="6165d9b475f0101a31ca94bd31563c167a2ba49b"

# --- 下载基地址 ---
DOWNLOAD_BASE_URL="https://atomgit.com/openeuler/yocto-meta-openeuler/releases/download"
