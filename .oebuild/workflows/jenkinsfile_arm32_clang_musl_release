def BUILD_COM

def createReleaseAndUploadFile(String yaml_path, String file_dir){
    sh """
        python3 main.py create_release \
        -gt ${env.GITEETOKEN} \
        -y ${yaml_path} \
        -f ${file_dir}
    """
}

pipeline {
    agent { node "${node}" }
    environment {
        PATH = "/home/jenkins/.local/bin:${env.PATH}"
    }
    stages {
        stage("init task"){
            steps{
                script{
                    BUILD_COM = load '.oebuild/workflows/build_common.groovy'
                    def INIT_ENV = load '.oebuild/workflows/init_env.groovy'
                    INIT_ENV.init_environment()
                }
            }
        }
        stage("download embedded-ci"){
            steps{
                dir("/home/jenkins/agent"){
                    script{
                        BUILD_COM.downloadEmbeddedCI(env.embeddedRemote, env.embeddedBranch)
                    }
                }
            }
        }
        stage("prepare source"){
            steps{
                dir("${env.WORKSPACE}/.oebuild/arm32-clang-musl-toolchain"){
                    sh "mkdir -p /home/jenkins/agent/arm32-clang-musl-workdir && sh prepare.sh /home/jenkins/agent/arm32-clang-musl-workdir"
                }
            }
        }
        stage("build toolchain"){
            steps{
                dir("/home/jenkins/agent/arm32-clang-musl-workdir"){
                    sh """
                        cp ${env.WORKSPACE}/.oebuild/arm32-clang-musl-toolchain/build-llvm-musl-arm32.sh .
                        ./build-llvm-musl-arm32.sh all \
                            --gcc-dir ./open_source/openeuler_gcc_arm32le-musl \
                            --llvm-src ./open_source/llvm-project \
                            --musl-src ./open_source/openeuler-musl/ \
                            --output-dir ./toolchain \
                            2>&1 | tee build.log
                    """
                }
            }
        }
        stage("package toolchain"){
            steps{
                dir("/home/jenkins/agent/arm32-clang-musl-workdir/toolchain"){
                    sh """
                        tar czf llvm-musl-arm.tar.gz llvm-musl-arm
                        mkdir release
                        split -b 200M llvm-musl-arm.tar.gz release/.part_
                        rm -f llvm-musl-arm.tar.gz
                        cd release
                        idx=1
                        for part in .part_*; do
                            mv "\$part" "\${idx}_llvm-musl-arm.tar.gz"
                            idx=\$((idx + 1))
                        done
                    """
                    writeFile(file: "release/merge_data.sh", text: '''#!/bin/bash
set -e
cat $(ls -v [0-9]*_llvm-musl-arm.tar.gz) > llvm-musl-arm.tar.gz
tar zxf llvm-musl-arm.tar.gz
rm -f llvm-musl-arm.tar.gz
echo "Toolchain extracted to llvm-musl-arm/"
''')
                    sh "chmod +x release/merge_data.sh"
                }
            }
        }
        stage("release arm32-clang-musl-toolchain"){
            steps{
                dir("/home/jenkins/agent/embedded-ci"){
                    script{
                        withCredentials([string(credentialsId: "${giteeId}", variable: 'GITEETOKEN')]){
                            yamlPath = "${env.WORKSPACE}/.oebuild/arm32-clang-musl-toolchain/release.yaml"
                            fileDir = "/home/jenkins/agent/arm32-clang-musl-workdir/toolchain/release"
                            createReleaseAndUploadFile(yamlPath, fileDir)
                        }
                    }
                }
            }
        }
    }
}
