def BUILD_COM

def createReleaseAndUploadFile(String yaml_path, String file_dir, gitee_token){
    sh """
        python3 main.py create_release \
        -gt ${gitee_token} \
        -y ${yaml_path} \
        -f ${file_dir}
    """
}

pipeline {
    agent { node "${node}" }
    environment {
        PATH = "/home/jenkins/.local/bin:${env.PATH}"
    }
    stages {
        stage("init task"){
            steps{
                script{
                    BUILD_COM = load '.oebuild/workflows/build_common.groovy'
                    def INIT_ENV = load '.oebuild/workflows/init_env.groovy'
                    INIT_ENV.init_environment()
                }
            }
        }
        stage("download embedded-ci"){
            steps{
                dir("/home/jenkins/agent"){
                    script{
                        BUILD_COM.downloadEmbeddedCI(env.embeddedRemote, env.embeddedBranch)
                    }
                }
            }
        }
        stage("download aarch64 chains"){
            steps{
                dir("/home/jenkins/agent"){
                    script{
                        // 下载aarch64-toolchains二进制编译链：v0.1.9起为单文件，历史版本及未来分卷发布为N_前缀分卷
                        sh """
                            wget -q --tries=3 https://atomgit.com/openeuler/yocto-meta-openeuler/releases/download/toolchains-v0.1.9/openeuler_gcc_arm64le.tar.gz || {
                                idx=1
                                while wget -q --tries=3 https://atomgit.com/openeuler/yocto-meta-openeuler/releases/download/toolchains-v0.1.9/\${idx}_openeuler_gcc_arm64le.tar.gz; do
                                    idx=\$((idx + 1))
                                done
                                [ \${idx} -gt 1 ] || { echo "no openeuler_gcc_arm64le assets found in toolchains-v0.1.9"; exit 1; }
                                cat \$(ls -v [0-9]*_openeuler_gcc_arm64le.tar.gz) > openeuler_gcc_arm64le.tar.gz
                                rm -f [0-9]*_openeuler_gcc_arm64le.tar.gz
                            }
                        """
                        // 解压二进制文件
                        sh """
                            tar zxf openeuler_gcc_arm64le.tar.gz
                        """
                    }
                }
            }
        }
        stage("prepare source"){
            steps{
                dir("${env.WORKSPACE}/.oebuild/llvm-toolchain"){
                    sh """
                        ./prepare.sh
                    """
                }
            }
        }
        stage("build llvm toolchain"){
            steps{
                dir("${env.WORKSPACE}/.oebuild/llvm-toolchain"){
                    sh """
                        ./build.sh ${env.WORKSPACE}/.oebuild/llvm-toolchain --gcc-dir /home/jenkins/agent/openeuler_gcc_arm64le --package --split-size 200M
                    """
                }
            }
        }
        stage("release llvm-toolchain"){
            steps{
                dir("/home/jenkins/agent/embedded-ci"){
                    script{
                        withCredentials([string(credentialsId: "${giteeId}", variable: 'GITEETOKEN')]){
                            pre_path = "${env.WORKSPACE}/.oebuild/llvm-toolchain"
                            sdkYamlPath = "${pre_path}/release.yaml"
                            fileDir = "${pre_path}/open_source/llvm-project/output"
                            createReleaseAndUploadFile(sdkYamlPath, fileDir, "$GITEETOKEN")
                        }
                    }
                }
            }
        }
    }
}
