def BUILD_COM

def createReleaseAndUploadFile(String yaml_path, String file_dir, gitee_token){
    sh """
        python3 main.py create_release \
        -gt ${gitee_token} \
        -y ${yaml_path} \
        -f ${file_dir}
    """
}

pipeline {
    agent { node "${node}" }
    environment {
        PATH = "/home/jenkins/.local/bin:${env.PATH}"
    }
    stages {
        stage("init task"){
            steps{
                script{
                    BUILD_COM = load '.oebuild/workflows/build_common.groovy'
                    def INIT_ENV = load '.oebuild/workflows/init_env.groovy'
                    INIT_ENV.init_environment()
                }
            }
        }
        stage("download embedded-ci"){
            steps{
                dir("/home/jenkins/agent"){
                    script{
                        BUILD_COM.downloadEmbeddedCI(env.embeddedRemote, env.embeddedBranch)
                    }
                }
            }
        }
        stage("install crosstool-ng"){
            steps{
                dir("/home/jenkins/agent/crosstool-ng"){
                    sh """
                        if command -v ct-ng >/dev/null 2>&1; then
                            echo "ct-ng already installed"
                            exit 0
                        fi
                        wget -q http://crosstool-ng.org/download/crosstool-ng/crosstool-ng-1.26.0.tar.bz2
                        tar jxf crosstool-ng-1.26.0.tar.bz2
                        cd crosstool-ng-1.26.0
                        ./configure --prefix=/home/jenkins/.local
                        make -j\$(nproc)
                        make install
                    """
                }
                sh "rm -rf /home/jenkins/agent/crosstool-ng"
            }
        }
        stage("prepare source"){
            steps{
                dir("${env.WORKSPACE}/.oebuild/cross-tools"){
                    sh """
                        ./prepare.sh
                        ./update.sh
                    """
                }
            }
        }
        stage("build toolchain"){
            steps{
                dir("${env.WORKSPACE}/.oebuild/cross-tools"){
                    script{
                        // 构建aarch64-toolchain
                        sh """
                            cp config_aarch64 .config
                            ct-ng build
                        """
                        // 构建arm32-toolchain
                        sh """
                            cp config_arm32 .config
                            ct-ng build
                        """
                        // 构建x86-64-toolchain
                        sh """
                            cp config_x86_64 .config
                            ct-ng build
                        """
                        // 构建riscv64-toolchain
                        sh """
                            cp config_riscv64 .config
                            ct-ng build
                        """
                        // 构建arm32-musl-toolchain
                        sh """
                            cp config_arm32-musl .config
                            ct-ng build
                        """
                    }
                }
            }
        }
        stage("package toolchain"){
            steps{
                dir("/home/jenkins/x-tools"){
                    // 打包aarch64-toolchain
                    sh """
                        mv aarch64-openeuler-linux-gnu openeuler_gcc_arm64le
                        tar czf openeuler_gcc_arm64le.tar.gz openeuler_gcc_arm64le
                        sudo rm -rf openeuler_gcc_arm64le
                    """
                    // 打包arm32-toolchain
                    sh """
                        mv arm-openeuler-linux-gnueabi openeuler_gcc_arm32le
                        tar czf openeuler_gcc_arm32le.tar.gz openeuler_gcc_arm32le
                        sudo rm -rf openeuler_gcc_arm32le
                    """
                    // 打包x86-64-toolchain
                    sh """
                        mv x86_64-openeuler-linux-gnu openeuler_gcc_x86_64
                        tar czf openeuler_gcc_x86_64.tar.gz openeuler_gcc_x86_64
                        sudo rm -rf openeuler_gcc_x86_64
                    """
                    // 打包riscv64-toolchain
                    sh """
                        mv riscv64-openeuler-linux-gnu openeuler_gcc_riscv64
                        tar czf openeuler_gcc_riscv64.tar.gz openeuler_gcc_riscv64
                        sudo rm -rf openeuler_gcc_riscv64
                    """
                    // 打包arm32-musl-toolchain
                    sh """
                        mv arm-openeuler-linux-musleabi openeuler_gcc_arm32le-musl
                        tar czf openeuler_gcc_arm32le-musl.tar.gz openeuler_gcc_arm32le-musl
                        sudo rm -rf openeuler_gcc_arm32le-musl
                    """
                    // 分卷：发布平台对单个附件有大小限制，各tar.gz按200M分卷
                    sh """
                        for tarball in openeuler_gcc_arm64le openeuler_gcc_arm32le openeuler_gcc_x86_64 openeuler_gcc_riscv64 openeuler_gcc_arm32le-musl; do
                            split -b 200M \${tarball}.tar.gz .part_
                            rm -f \${tarball}.tar.gz
                            idx=1
                            for part in .part_*; do
                                mv "\$part" "\${idx}_\${tarball}.tar.gz"
                                idx=\$((idx + 1))
                            done
                        done
                    """
                    writeFile(file: "merge_data.sh", text: '''#!/bin/bash
set -e
for name in $(ls [0-9]*_*.tar.gz | sed 's/^[0-9]*_//' | sort -u); do
    cat $(ls -v *_${name}) > ${name}
    tar zxf ${name}
    rm -f ${name}
done
echo "All toolchains extracted."
''')
                    sh "chmod +x merge_data.sh"
                }
            }
        }
        stage("release gcc-toolchain"){
            steps{
                dir("/home/jenkins/agent/embedded-ci"){
                    script{
                        withCredentials([string(credentialsId: "${giteeId}", variable: 'GITEETOKEN')]){
                            sdkYamlPath = "${env.WORKSPACE}/.oebuild/cross-tools/release.yaml"
                            fileDir = "/home/jenkins/x-tools"
                            createReleaseAndUploadFile(sdkYamlPath, fileDir, "$GITEETOKEN")
                        }
                    }
                }
            }
        }
    }
}
