#!/bin/sh
### BEGIN INIT INFO
# Provides:          openeuler-motd
# Required-Start:    $local_fs
# Required-Stop:
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Generate openEuler Embedded dynamic motd
# Description:       Build /run/motd with the color banner and runtime
#                    system info, displayed by sshd and login.
### END INIT INFO

case "$1" in
  start)
      /usr/libexec/openeuler-motd.sh
      ;;
  stop|restart|force-reload|status)
      ;;
  *)
      echo "Usage: $0 {start|stop|restart|force-reload|status}"
      exit 1
esac

exit 0
