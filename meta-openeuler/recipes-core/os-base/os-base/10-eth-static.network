[Match]
Name=eth*

[Network]
Address=192.168.7.2/24
Gateway=192.168.7.1
DHCP=ipv4
# The static address above is the intended fallback when no DHCP
# server answers. Keep only IPv6 link-local addressing so that IPv4LL
# (169.254.0.0/16) does not add a duplicate address and a bogus
# 'default dev <iface> scope link' route on multi-interface boards.
LinkLocalAddressing=ipv6
