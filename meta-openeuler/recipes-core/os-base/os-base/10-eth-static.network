[Match]
Name=eth0

[Network]
Address=192.168.7.2/24
Gateway=192.168.7.1
DHCP=ipv4
# Only the primary port gets the static fallback. Matching eth* here would
# give every port the same address and default gateway; secondary ports are
# handled by 20-eth-secondary.network.
# Keep only IPv6 link-local addressing so that IPv4LL (169.254.0.0/16) does
# not add a duplicate address and a bogus 'default dev <iface> scope link'
# route on multi-interface boards.
LinkLocalAddressing=ipv6
