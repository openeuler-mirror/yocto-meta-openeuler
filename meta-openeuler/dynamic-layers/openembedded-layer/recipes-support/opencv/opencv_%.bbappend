# main bbfile: yocto-meta-openembedded/meta-oe/recipes-support/opencv/opencv_4.5.5.bb

PV = "4.14.0"

FILESEXTRAPATHS:prepend := "${THISDIR}/opencv:"

# use src-openeuler's source
SRC_URI:prepend = " \
        file://${BP}.tar.gz \
        "

# drop the meta-oe 4.5.x-era patches: they are all upstreamed in 4.14.0
# or fix packaging that does not apply to the src-repo tarball build
# (contrib/ade are not used here, same as with 4.5.2)
SRC_URI:remove = " \
        file://0001-3rdparty-ippicv-Use-pre-downloaded-ipp.patch \
        file://0003-To-fix-errors-as-following.patch \
        file://0001-Temporarliy-work-around-deprecated-ffmpeg-RAW-functi.patch \
        file://0001-Dont-use-isystem.patch \
        file://0001-Make-ts-module-external.patch \
        file://0001-core-vsx-update-vec_absd-workaround-condition.patch \
        file://download.patch \
        file://CVE-2023-2617.patch;patchdir=../contrib \
        "

do_unpack_extra() {
}

S = "${WORKDIR}/${BP}"

# no support of ade package in src-openeuler currently,
# so remove it from pkgconfig
PACKAGECONFIG:remove = "gapi"

# ippicv is not enable in src-openuler, so sync the config to our recipes
EXTRA_OECMAKE:append = " \
    -DWITH_IPP=OFF \
"
EXTRA_OECMAKE:remove = " \
    -DOPENCV_EXTRA_MODULES_PATH=${WORKDIR}/contrib/modules \
    -DOPENCV_ICV_HASH=${IPP_MD5} \
    -DIPPROOT=${WORKDIR}/ippicv_lnx \
    -DOPENCV_DOWNLOAD_PATH=${OPENCV_DLDIR} \
"

PACKAGECONFIG += " dnn "

# dnn's PACKAGECONFIG in the main recipe stages protobuf-native for
# the protoc tool below; keep it explicit so the native tool stays
# available (and in the task signature) even if the PACKAGECONFIG
# dependency list changes later
DEPENDS += "protobuf-native"

# The pb files shipped in the 4.14 tarball are generated by an old
# protobuf and do not compile against 25.1 headers, and letting the
# build regenerate them (PROTOBUF_UPDATE_FILES=ON) is not an option
# either: protobuf stages the target protoc into recipe-sysroot and
# protobuf_generate() hardcodes the protobuf::protoc imported target
# (that staged aarch64 binary) as the command - the PROTOC_EXE
# argument only feeds the dependencies list, so
# -DProtobuf_PROTOC_EXECUTABLE cannot redirect it. Regenerate the
# files with the native protoc instead and build with
# PROTOBUF_UPDATE_FILES=OFF (which uses the pre-generated files).
EXTRA_OECMAKE:append = " -DPROTOBUF_UPDATE_FILES=OFF"

do_configure:prepend() {
    (cd ${S}/modules/dnn/src/caffe &&
     ${STAGING_BINDIR_NATIVE}/protoc --proto_path=. \
        --cpp_out=${S}/modules/dnn/misc/caffe *.proto)
    (cd ${S}/modules/dnn/src/onnx &&
     ${STAGING_BINDIR_NATIVE}/protoc --proto_path=. \
        --cpp_out=${S}/modules/dnn/misc/onnx *.proto)
    (cd ${S}/modules/dnn/src/tensorflow &&
     ${STAGING_BINDIR_NATIVE}/protoc --proto_path=. \
        --cpp_out=${S}/modules/dnn/misc/tensorflow *.proto)
}
# opencv 4.14 requires C++17
EXTRA_OECMAKE:append = " -DCMAKE_CXX_STANDARD=17"
# opencv 4.14 declares OPENCV_PYTHON3_VERSION with an empty option
# default, which modern cmake canonicalizes to OFF and then fails in
# find_package(Python3 "OFF"); pass a major version only so the
# recipe does not track the distro's python minor version
EXTRA_OECMAKE:append = " -DOPENCV_PYTHON3_VERSION=3"

ASSUME_PROVIDE_PKGS:${PN} = "opencv"
