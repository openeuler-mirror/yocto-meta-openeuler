diff -ruN orig/boards/raspberrypi/rpi_4b/rpi_4b_bcm2711_remote_defconfig new/boards/raspberrypi/rpi_4b/rpi_4b_bcm2711_remote_defconfig
--- orig/boards/raspberrypi/rpi_4b/rpi_4b_bcm2711_remote_defconfig	1970-01-01 08:00:00.000000000 +0800
